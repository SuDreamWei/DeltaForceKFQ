<Window x:Class="DeltaHarmonica.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="三角洲行动 · 口风琴自动演奏器"
        Height="720" Width="1060" MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR ==================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- brand -->
                <StackPanel Grid.Row="0" Margin="20,22,20,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8"
                                Background="{StaticResource AccentBrush}">
                            <TextBlock Text="♪" FontSize="17" FontWeight="Bold"
                                       Foreground="#FF1A1408"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="口风琴演奏器" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="三角洲行动" FontSize="10.5"
                                       Foreground="{StaticResource TextDimBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- nav -->
                <StackPanel Grid.Row="1" Margin="12,0">
                    <RadioButton x:Name="NavImport" Style="{StaticResource NavButton}" GroupName="Nav"
                                 IsChecked="True" Tag="import" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="15" Width="24" />
                            <TextBlock Text="选择音频" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavConvert" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Tag="convert" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⇄" FontSize="15" Width="24" />
                            <TextBlock Text="转换谱面" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavList" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Tag="list" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☰" FontSize="15" Width="24" />
                            <TextBlock Text="候选列表" />
                            <Border x:Name="ListCountBadge" Background="{StaticResource CardHoverBrush}"
                                    CornerRadius="9" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="ListCountText" Text="0" FontSize="10.5"
                                           Foreground="{StaticResource TextDimBrush}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavPlay" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Tag="play" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" FontSize="14" Width="24" />
                            <TextBlock Text="演奏" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- settings shortcut -->
                <StackPanel Grid.Row="2" Margin="12,10,12,16">
                    <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="4,0,4,10" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav"
                                 Tag="settings" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="15" Width="24" />
                            <TextBlock Text="设置" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== CONTENT ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <StackPanel Grid.Row="0" Margin="30,26,30,0">
                <TextBlock x:Name="PageTitle" Text="选择音频" Style="{StaticResource H1}" />
                <TextBlock x:Name="PageSubtitle" Text="导入 .mid / .midi 文件，或直接载入三角洲口琴谱 TXT"
                           Style="{StaticResource Dim}" Margin="0,5,0,0" />
            </StackPanel>

            <!-- pages -->
            <Grid Grid.Row="1" Margin="30,20,30,10">
                <ScrollViewer x:Name="PageImport" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="导入 MIDI 文件" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,14"
                                           Text="支持标准 MIDI 文件（format 0 / 1）。导入后会分析和弦、音域，并自动折叠八度以适配口琴的 8 个音级。" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="选择文件…" Style="{StaticResource PrimaryButton}"
                                            Click="ImportMidi_Click" />
                                    <Button Content="打开所在文件夹" Style="{StaticResource GhostButton}"
                                            Margin="10,0,0,0" Click="OpenSongFolder_Click" />
                                </StackPanel>
                                <TextBlock x:Name="ImportHint" Style="{StaticResource Dim}" Margin="0,12,0,0"
                                           Text="提示：也可以把文件直接拖进这个窗口。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="最近的导入" Style="{StaticResource H2}" />
                                <ItemsControl x:Name="RecentImportList" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                                <TextBlock Text="•" Foreground="{StaticResource AccentBrush}"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding}" Style="{StaticResource Dim}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="RecentEmpty" Text="还没有导入过文件。"
                                           Style="{StaticResource Dim}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PageConvert" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="三角洲口琴谱 TXT → MIDI" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,14"
                                           Text="解析口琴谱 TXT（含「小节 / 简谱 / 键位 / 节奏」四行格式），既可生成 .mid 导出，也能直接加入候选列表演奏。" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="选择 TXT 谱面…" Style="{StaticResource PrimaryButton}"
                                            Click="ConvertTxt_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ConvertResultCard" Style="{StaticResource Card}" Margin="0,14,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="解析结果" Style="{StaticResource H2}" />
                                <TextBlock x:Name="ConvertSummary" Style="{StaticResource Body}"
                                           Margin="0,8,0,0" />
                                <ItemsControl x:Name="ConvertWarnings" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Dim}"
                                                       Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="ConvertAddBtn" Content="加入候选列表"
                                            Style="{StaticResource PrimaryButton}" Click="ConvertAdd_Click" />
                                    <Button x:Name="ConvertExportBtn" Content="导出为 .mid"
                                            Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                            Click="ConvertExport_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="PageList" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="↑ 上移" Style="{StaticResource GhostButton}" Click="MoveUp_Click" />
                        <Button Content="↓ 下移" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Click="MoveDown_Click" />
                        <Button Content="重命名" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Click="Rename_Click" />
                        <Button Content="移除" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Click="Remove_Click" />
                        <Button Content="清空" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Click="Clear_Click" />
                    </StackPanel>

                    <ListBox x:Name="SongList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SongItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="SongList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                            Background="{StaticResource AccentDimBrush}" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding SourceKind}" FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Dim}" Margin="0,2,0,0">
                                            <Run Text="{Binding NoteCountText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding DurationText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="✕" Style="{StaticResource IconButton}"
                                            Tag="{Binding}" Click="RemoveOne_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="ListEmptyHint" Grid.Row="1"
                               Text="候选列表是空的。先去「选择音频」或「转换谱面」添加歌曲。"
                               Style="{StaticResource Dim}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer x:Name="PagePlay" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="当前歌曲" Style="{StaticResource H2}" />
                                <TextBlock x:Name="NowPlayingTitle" Text="（未选择）"
                                           FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0"
                                           Foreground="{StaticResource AccentBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="NowPlayingMeta" Style="{StaticResource Dim}" Margin="0,4,0,0" />

                                <ProgressBar x:Name="PlayProgress" Height="6" Margin="0,16,0,0"
                                             Minimum="0" Maximum="100" Value="0"
                                             Background="#FF151821"
                                             Foreground="{StaticResource AccentBrush}"
                                             BorderThickness="0" />

                                <TextBlock x:Name="PlayStatus" Style="{StaticResource Dim}" Margin="0,8,0,0"
                                           Text="就绪。" />
                                <TextBlock x:Name="LockStateHint" Style="{StaticResource Dim}" Margin="0,4,0,0"
                                           Text="○ 键鼠未锁定" />

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="PlayBtn" Content="▶  开始演奏"
                                            Style="{StaticResource PrimaryButton}" Click="Play_Click" />
                                    <Button x:Name="InstantBtn" Content="⚡  立即演奏"
                                            Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                            Click="InstantPlay_Click"
                                            ToolTip="跳过准备倒计时，立刻开始发送按键" />
                                    <Button x:Name="PauseBtn" Content="⏸  暂停"
                                            Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                            Click="Pause_Click" IsEnabled="False" />
                                    <Button x:Name="StopBtn" Content="■  停止"
                                            Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                            Click="Stop_Click" IsEnabled="False" />
                                    <Button Content="输入自检" Style="{StaticResource GhostButton}"
                                            Margin="10,0,0,0" Click="SelfTest_Click" />
                                </StackPanel>

                                <CheckBox x:Name="LockInputCheck" Content="演奏期间锁定键鼠（防误触）"
                                          Foreground="{StaticResource TextBrush}" Margin="0,14,0,0"
                                          Click="LockInput_Click"
                                          ToolTip="拦截真实键鼠输入，只放行本程序发送的按键。紧急停止热键始终有效。" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0"
                                           Text="锁定后物理键鼠会被拦下，鼠标仍可移动但按键与滚轮无效。按停止热键可随时解除。" />
                            </StackPanel>
                        </Border>

                        <!-- ===== audition ===== -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="试听（本机播放，不会发送到游戏）" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,12"
                                           Text="先用合成音试听旋律和效果，确认无误再去游戏里演奏。" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="AuditionBtn" Content="♪  试听"
                                            Style="{StaticResource PrimaryButton}" Click="Audition_Click" />
                                    <Button x:Name="PrevBtn" Content="上一首" Style="{StaticResource GhostButton}"
                                            Margin="10,0,0,0" Click="PrevSong_Click" />
                                    <Button x:Name="NextBtn" Content="下一首" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" Click="NextSong_Click" />
                                </StackPanel>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="试听音量"
                                               Style="{StaticResource Body}" VerticalAlignment="Center" />
                                    <Slider Grid.Row="0" Grid.Column="1" x:Name="VolSlider"
                                            Style="{StaticResource SliderStyle}"
                                            Minimum="0" Maximum="100" Value="35"
                                            ValueChanged="VolSlider_ValueChanged" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="VolValue"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="试听音高"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"
                                               Margin="0,8,0,0" />
                                    <Slider Grid.Row="1" Grid.Column="1" x:Name="TransposeSlider"
                                            Style="{StaticResource SliderStyle}" Margin="0,8,0,0"
                                            Minimum="-24" Maximum="24" Value="0" TickFrequency="1"
                                            ValueChanged="TransposeSlider_ValueChanged" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TransposeValue"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"
                                               Margin="0,8,0,0" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ===== melody preview ===== -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="旋律预览" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,10"
                                           Text="点击预览条可以定位播放起点。高亮区域是当前播放区间。" />
                                <Border Background="#FF12141A" CornerRadius="8" Padding="6"
                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                    <Canvas x:Name="PreviewCanvas" Height="150"
                                            Background="Transparent"
                                            MouseLeftButtonDown="PreviewCanvas_MouseDown"
                                            MouseMove="PreviewCanvas_MouseMove"
                                            MouseLeftButtonUp="PreviewCanvas_MouseUp"
                                            ClipToBounds="True" />
                                </Border>
                                <TextBlock x:Name="PreviewHint" Style="{StaticResource Dim}"
                                           Margin="0,8,0,0" Text="（未选择歌曲）" />

                                <TextBlock Text="按键序列（前 40 个）" Style="{StaticResource Dim}"
                                           Margin="0,12,0,6" />
                                <Border Background="#FF12141A" CornerRadius="7" Padding="10,8"
                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                                    <TextBlock x:Name="PreviewListFallback" FontSize="11.5"
                                               FontFamily="Consolas" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextDimBrush}"
                                               Text="（未选择歌曲）" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ===== trim ===== -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="播放区间（裁剪）" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,12"
                                           Text="只演奏选定的一段，适合练习某一句。左右拖动下面的滑块即可调整。" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="起点"
                                               Style="{StaticResource Body}" VerticalAlignment="Center" />
                                    <Slider Grid.Row="0" Grid.Column="1" x:Name="TrimStartSlider"
                                            Style="{StaticResource SliderStyle}"
                                            Minimum="0" Maximum="100" Value="0"
                                            ValueChanged="TrimStartSlider_ValueChanged" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="TrimStartValue"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="终点"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"
                                               Margin="0,8,0,0" />
                                    <Slider Grid.Row="1" Grid.Column="1" x:Name="TrimEndSlider"
                                            Style="{StaticResource SliderStyle}" Margin="0,8,0,0"
                                            Minimum="0" Maximum="100" Value="100"
                                            ValueChanged="TrimEndSlider_ValueChanged" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TrimEndValue"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"
                                               Margin="0,8,0,0" HorizontalAlignment="Right" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="重置为整首" Style="{StaticResource GhostButton}"
                                            Click="TrimReset_Click" />
                                    <Button Content="设为当前光标" Style="{StaticResource GhostButton}"
                                            Margin="10,0,0,0" Click="TrimFromCursor_Click" />
                                    <TextBlock x:Name="TrimInfo" Style="{StaticResource Dim}"
                                               VerticalAlignment="Center" Margin="14,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="当前配置" Style="{StaticResource H2}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="准备时间"
                                               Style="{StaticResource Dim}" Margin="0,4" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CfgLead"
                                               Style="{StaticResource Body}" Margin="0,4" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="人性化抖动"
                                               Style="{StaticResource Dim}" Margin="0,4" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CfgJitter"
                                               Style="{StaticResource Body}" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="演奏速度"
                                               Style="{StaticResource Dim}" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CfgSpeed"
                                               Style="{StaticResource Body}" Margin="0,4" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="全局热键"
                                               Style="{StaticResource Dim}" Margin="0,4" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CfgHotkeys"
                                               Style="{StaticResource Body}" Margin="0,4" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="全局热键" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,14"
                                           Text="在任意窗口（包括游戏）中都生效。点击输入框后直接按下想用的组合键。" />
                                <Grid x:Name="HotkeyGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="演奏参数" Style="{StaticResource H2}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="准备时间"
                                               Style="{StaticResource Body}" VerticalAlignment="Center" />
                                    <Slider Grid.Row="0" Grid.Column="1" x:Name="LeadSlider" Style="{StaticResource SliderStyle}"
                                            Minimum="0" Maximum="10000" TickFrequency="500"
                                            ValueChanged="LeadSlider_ValueChanged" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LeadValue"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="时长抖动"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"
                                               Margin="0,10,0,0" />
                                    <Slider Grid.Row="1" Grid.Column="1" x:Name="DurJitterSlider" Margin="0,10,0,0"
                                            Style="{StaticResource SliderStyle}"
                                            Minimum="0" Maximum="40" TickFrequency="1"
                                            ValueChanged="DurJitterSlider_ValueChanged" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="DurJitterValue" Margin="0,10,0,0"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="间隔抖动"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"
                                               Margin="0,10,0,0" />
                                    <Slider Grid.Row="2" Grid.Column="1" x:Name="TimeJitterSlider" Margin="0,10,0,0"
                                            Style="{StaticResource SliderStyle}"
                                            Minimum="0" Maximum="40" TickFrequency="1"
                                            ValueChanged="TimeJitterSlider_ValueChanged" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="TimeJitterValue" Margin="0,10,0,0"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="演奏速度"
                                               Style="{StaticResource Body}" VerticalAlignment="Center"
                                               Margin="0,10,0,0" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,10,0,0">
                                        <Slider x:Name="SpeedSlider" Style="{StaticResource SliderStyle}"
                                                Minimum="0.3" Maximum="2.5" TickFrequency="0.05"
                                                ValueChanged="SpeedSlider_ValueChanged"
                                                ToolTip="拖动微调，或点下面的快捷倍率" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="0.5×" Style="{StaticResource GhostButton}"
                                                    Padding="10,4" Margin="0,0,6,6" Click="SpeedPreset_Click" Tag="0.5" />
                                            <Button Content="0.8×" Style="{StaticResource GhostButton}"
                                                    Padding="10,4" Margin="0,0,6,6" Click="SpeedPreset_Click" Tag="0.8" />
                                            <Button Content="1.0×" Style="{StaticResource GhostButton}"
                                                    Padding="10,4" Margin="0,0,6,6" Click="SpeedPreset_Click" Tag="1.0" />
                                            <Button Content="1.2×" Style="{StaticResource GhostButton}"
                                                    Padding="10,4" Margin="0,0,6,6" Click="SpeedPreset_Click" Tag="1.2" />
                                            <Button Content="1.5×" Style="{StaticResource GhostButton}"
                                                    Padding="10,4" Margin="0,0,6,6" Click="SpeedPreset_Click" Tag="1.5" />
                                            <Button Content="2.0×" Style="{StaticResource GhostButton}"
                                                    Padding="10,4" Margin="0,0,6,6" Click="SpeedPreset_Click" Tag="2.0" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Dim}" Margin="0,2,0,0"
                                                   Text="倍速会同时作用于试听与实际演奏：1.2× 更快，0.8× 更慢。" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="SpeedValue" Margin="0,10,0,0"
                                               Style="{StaticResource Body}" VerticalAlignment="Top"
                                               HorizontalAlignment="Right" />

                                    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                              x:Name="HumaniseCheck" Content="启用人性化抖动（时长与间隔随机化）"
                                              Foreground="{StaticResource TextBrush}" Margin="0,14,0,0"
                                              Click="Humanise_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="窗口行为" Style="{StaticResource H2}" />
                                <CheckBox x:Name="TrayCheck" Content="关闭窗口时最小化到托盘（而不是退出）"
                                          Foreground="{StaticResource TextBrush}" Margin="0,12,0,0"
                                          Click="Tray_Click" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,10,0,0"
                                           Text="本程序不读取游戏内存、不修改游戏文件，只发送标准键盘鼠标输入事件。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- status bar -->
            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0"
                    Padding="30,9">
                <Grid>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Dim}"
                               VerticalAlignment="Center" Text="就绪" />
                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Dim}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
